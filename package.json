{
    "name": "wordpress-snippets-manager",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "4.2.3",
    "publisher": "trae-ai",
    "author": "eliodata.com",
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/eliodata/eliodata-snippet-hub.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Dans un workspace non approuvé, les snippets restent consultables mais aucune modification n’est envoyée à WordPress, et les réglages de stockage et de synchronisation du workspace sont ignorés.",
            "restrictedConfigurations": [
                "wordpressSnippets.workspaceStoragePath",
                "wordpressSnippets.obsidianVaultPath",
                "wordpressSnippets.workspaceConnectionId",
                "wordpressSnippets.workspaceSiteFolder",
                "wordpressSnippets.syncRole"
            ]
        }
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:wordpress-snippets-view",
        "onCommand:wordpressSnippets.list",
        "onCommand:wordpressSnippets.manageConnections",
        "onCommand:wordpressSnippets.switchConnection",
        "workspaceContains:**/*.md"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "wordpressSnippets.list",
                "title": "%command.list%"
            },
            {
                "command": "wordpressSnippets.create",
                "title": "%command.create%"
            },
            {
                "command": "wordpressSnippets.delete",
                "title": "%command.delete%"
            },
            {
                "command": "wordpressSnippets.configure",
                "title": "%command.configure%"
            },
            {
                "command": "wordpressSnippets.refresh",
                "title": "%command.refresh%",
                "icon": "$(refresh)"
            },
            {
                "command": "wordpressSnippets.createSnippet",
                "title": "%command.newSnippet%",
                "icon": "$(add)"
            },
            {
                "command": "wordpressSnippets.openSnippet",
                "title": "%command.openSnippet%"
            },
            {
                "command": "wordpressSnippets.toggleSnippet",
                "title": "%command.toggleActive%"
            },
            {
                "command": "wordpressSnippets.sortAsc",
                "title": "%command.sortAsc%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "wordpressSnippets.sortDesc",
                "title": "%command.sortDesc%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "wordpressSnippets.analyzeSnippet",
                "title": "%command.analyze%"
            },
            {
                "command": "wordpressSnippets.filterActive",
                "title": "%command.filterActive%"
            },
            {
                "command": "wordpressSnippets.filterInactive",
                "title": "%command.filterInactive%"
            },
            {
                "command": "wordpressSnippets.filterAll",
                "title": "%command.filterAll%"
            },
            {
                "command": "wordpressSnippets.searchSnippets",
                "title": "%command.search%",
                "icon": "$(search)"
            },
            {
                "command": "wordpressSnippets.clearSearch",
                "title": "%command.clearSearch%",
                "icon": "$(clear-all)"
            },
            {
                "command": "wordpressSnippets.restoreBackup",
                "title": "%command.restoreBackup%"
            },
            {
                "command": "wordpress-snippets.switchPlugin",
                "title": "%command.switchPlugin%",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "wordpressSnippets.manageConnections",
                "title": "%command.manageConnections%",
                "icon": "$(server-environment)"
            },
            {
                "command": "wordpressSnippets.switchConnection",
                "title": "%command.switchConnection%",
                "icon": "$(globe)"
            },
            {
                "command": "wordpressSnippets.renameSnippet",
                "title": "%command.rename%",
                "icon": "$(edit)"
            },
            {
                "command": "wordpressSnippets.editDescription",
                "title": "%command.editDescription%",
                "icon": "$(note)"
            },
            {
                "command": "wordpressSnippets.editTags",
                "title": "%command.editTags%",
                "icon": "$(tag)"
            },
            {
                "command": "wordpressSnippets.editAttribution",
                "title": "%command.editAttribution%",
                "icon": "$(target)"
            },
            {
                "command": "wordpressSnippets.refreshMcpTools",
                "title": "%command.refreshMcpTools%",
                "icon": "$(sync)"
            },
            {
                "command": "wordpressSnippets.listMcpTools",
                "title": "%command.listMcpTools%",
                "icon": "$(tools)"
            },
            {
                "command": "wordpressSnippets.callMcpTool",
                "title": "%command.callMcpTool%",
                "icon": "$(play)"
            },
            {
                "command": "wordpressSnippets.callCurrentMcpTool",
                "title": "%command.callCurrentMcpTool%",
                "icon": "$(rocket)"
            },
            {
                "command": "wordpressSnippets.createCustomMcpTool",
                "title": "%command.createCustomMcpTool%",
                "icon": "$(add)"
            },
            {
                "command": "wordpressSnippets.updateCustomMcpTool",
                "title": "%command.updateCustomMcpTool%",
                "icon": "$(edit)"
            },
            {
                "command": "wordpressSnippets.deleteCustomMcpTool",
                "title": "%command.deleteCustomMcpTool%",
                "icon": "$(trash)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "wordpressSnippets.createSnippet",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@1"
                },
                {
                    "command": "wordpressSnippets.refresh",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@2"
                },
                {
                    "command": "wordpressSnippets.searchSnippets",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@3"
                },
                {
                    "command": "wordpressSnippets.clearSearch",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@3"
                },
                {
                    "command": "wordpressSnippets.sortAsc",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@4"
                },
                {
                    "command": "wordpressSnippets.sortDesc",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@5"
                },
                {
                    "command": "wordpressSnippets.filterActive",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@6",
                    "icon": "$(filter)"
                },
                {
                    "command": "wordpressSnippets.filterInactive",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@7",
                    "icon": "$(filter)"
                },
                {
                    "command": "wordpressSnippets.filterAll",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@8",
                    "icon": "$(clear-all)"
                },
                {
                    "command": "wordpress-snippets.switchPlugin",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@9",
                    "icon": "$(arrow-swap)"
                },
                {
                    "command": "wordpressSnippets.manageConnections",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@10",
                    "icon": "$(server-environment)"
                },
                {
                    "command": "wordpressSnippets.switchConnection",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@11",
                    "icon": "$(globe)"
                },
                {
                    "command": "wordpressSnippets.refreshMcpTools",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@12",
                    "icon": "$(sync)"
                },
                {
                    "command": "wordpressSnippets.listMcpTools",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@13",
                    "icon": "$(tools)"
                },
                {
                    "command": "wordpressSnippets.callMcpTool",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@14",
                    "icon": "$(play)"
                },
                {
                    "command": "wordpressSnippets.createCustomMcpTool",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@15",
                    "icon": "$(add)"
                },
                {
                    "command": "wordpressSnippets.updateCustomMcpTool",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@16",
                    "icon": "$(edit)"
                },
                {
                    "command": "wordpressSnippets.deleteCustomMcpTool",
                    "when": "view == wordpress-snippets-view",
                    "group": "navigation@17",
                    "icon": "$(trash)"
                }
            ],
            "view/item/context": [
                {
                    "command": "wordpressSnippets.openSnippet",
                    "when": "viewItem == snippet",
                    "group": "navigation@1"
                },
                {
                    "command": "wordpressSnippets.toggleSnippet",
                    "when": "viewItem == snippet",
                    "group": "inline"
                },
                {
                    "command": "wordpressSnippets.renameSnippet",
                    "when": "viewItem == snippet",
                    "group": "navigation@2"
                },
                {
                    "command": "wordpressSnippets.editDescription",
                    "when": "viewItem == snippet",
                    "group": "navigation@3"
                },
                {
                    "command": "wordpressSnippets.editTags",
                    "when": "viewItem == snippet",
                    "group": "navigation@4"
                },
                {
                    "command": "wordpressSnippets.editAttribution",
                    "when": "viewItem == snippet",
                    "group": "navigation@5"
                },
                {
                    "command": "wordpressSnippets.analyzeSnippet",
                    "when": "viewItem == snippet",
                    "group": "navigation@6"
                },
                {
                    "command": "wordpressSnippets.delete",
                    "when": "viewItem == snippet",
                    "group": "navigation@7"
                },
                {
                    "command": "wordpressSnippets.restoreBackup",
                    "when": "viewItem == snippet",
                    "group": "navigation@8"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "wordpress-snippets-manager",
                    "title": "%viewContainer.title%",
                    "icon": "assets/wordpress-logo.svg"
                }
            ]
        },
        "views": {
            "wordpress-snippets-manager": [
                {
                    "id": "wordpress-snippets-view",
                    "name": "%view.snippets%",
                    "icon": "assets/wordpress-logo.svg"
                }
            ]
        },
        "keybindings": [
            {
                "command": "wordpressSnippets.searchSnippets",
                "key": "ctrl+f",
                "when": "view == wordpress-snippets-view && viewItem != snippet"
            },
            {
                "command": "wordpressSnippets.clearSearch",
                "key": "escape",
                "when": "view == wordpress-snippets-view"
            }
        ],
        "configuration": {
            "title": "WordPress Companion",
            "properties": {
                "wordpressSnippets.workspaceStoragePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Chemin absolu vers le **dossier de stockage local** des snippets, sauvegardes et caches MCP. Si ce champ est vide, l’extension crée et utilise automatiquement un dossier interne. Aucune configuration spéciale n’est nécessaire au démarrage de l’IDE. Exemple dans un vault Obsidian : `/Users/votre-nom/Documents/Obsidian/Vault/wordpress-companion`."
                },
                "wordpressSnippets.obsidianVaultPath": {
                    "type": "string",
                    "default": "",
                    "markdownDeprecationMessage": "Utilisez `wordpressSnippets.workspaceStoragePath` à la place.",
                    "markdownDescription": "Ancien nom du chemin de stockage local. Conservé uniquement pour compatibilité avec les versions précédentes."
                },
                "wordpressSnippets.workspaceConnectionId": {
                    "type": "string",
                    "default": "",
                    "scope": "window",
                    "markdownDescription": "Option avancée. ID de la **connexion WordPress privilégiée** pour le workspace courant."
                },
                "wordpressSnippets.workspaceSiteFolder": {
                    "type": "string",
                    "default": "",
                    "scope": "window",
                    "markdownDescription": "Option avancée. Nom du dossier `site-*` à associer au workspace courant dans le stockage local. Exemple : `site-mon-site`."
                },
                "wordpressSnippets.syncRole": {
                    "type": "string",
                    "default": "owner",
                    "scope": "window",
                    "enum": [
                        "owner",
                        "editor",
                        "off"
                    ],
                    "markdownEnumDescriptions": [
                        "Le workspace courant pilote la synchronisation entre WordPress et le stockage local.",
                        "Le workspace courant reste en lecture seule locale pendant qu’un autre workspace pilote la synchronisation.",
                        "La synchronisation de ce workspace est désactivée."
                    ],
                    "markdownDescription": "Choisit le **rôle de synchronisation** du workspace courant entre WordPress et le stockage local."
                },
                "wordpressSnippets.domainRules": {
                    "type": "array",
                    "default": [],
                    "scope": "resource",
                    "items": {
                        "type": "object",
                        "required": [
                            "domain",
                            "keywords"
                        ],
                        "properties": {
                            "domain": {
                                "type": "string"
                            },
                            "keywords": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "markdownDescription": "Règles utilisées pour remplir le champ `domain` du frontmatter des snippets. Chaque règle associe un domaine à des mots-clés recherchés dans le nom, le titre et le code. Laissez vide pour utiliser les règles WordPress génériques. Exemple : `[{ \"domain\": \"facturation\", \"keywords\": [\"invoice\", \"facture\"] }]`."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "^16.x",
        "@types/vscode": "^1.60.0",
        "@types/yaml": "^1.9.6",
        "@typescript-eslint/eslint-plugin": "^5.x",
        "@typescript-eslint/parser": "^5.x",
        "eslint": "^8.x",
        "typescript": "^4.9.5",
        "vsce": "^2.15.0"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "yaml": "^2.8.3"
    }
}
